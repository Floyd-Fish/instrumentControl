__pycache__/
*.pyc

# 运行期缓存：现写在用户级缓存目录 %LOCALAPPDATA%\instrumentControl\
# （旧位置在包目录内，仅兼容读一次后删除；此规则保留作兜底）
.last_good_resource.json

# 本机地址配置属于「每台机器一份」，正式位置在 %LOCALAPPDATA%\instrumentControl\devices.json；
# 这里兜底防止有人把含真实 IP 的 devices.json 误提交到仓库（模板走 config_cli.py init）
devices.json

# ---- TEST_DATA 运行期产物（体量大、可由设备重建，不入库）----
# MCP 通用写审计日志（每次调用追加，运行时数据）
TEST_DATA/**/mcp_scpi_audit_*.jsonl
# MCP 截屏 PNG（sds_screenshot 产物）
TEST_DATA/**/mcp_sds_*.png
# MCP 波形 CSV（sds_get_waveform(save_csv=True) 产物，单文件 3-4MB）
TEST_DATA/**/mcp_sds_wave_*.csv
# MHO 同类产物（mho_screenshot / mho_get_waveform；RAW CSV 单文件 1MB+）
TEST_DATA/**/mcp_mho_*.png
TEST_DATA/**/mcp_mho_wave_*.csv
TEST_DATA/**/mho_raw_ch1_*.csv
# MHO 验收脚本的截屏/波形产物（留痕 JSON 仍入库）
TEST_DATA/**/mho_verify_*.png
TEST_DATA/**/mho_wave_ch1_*.csv
TEST_DATA/**/smoke_shot.png
# 历史遗留的原始截屏 BMP（单文件 ≈2.3MB）
TEST_DATA/**/*.bmp

# 说明：TEST_DATA/**/*.json（小体积实测留痕）仍然入库，作为可回溯证据。

# ---- 本机专有事实 / 运行期产物（不入库）----
# 设备序列号、固件、实测资源串、现场带电状态：换机器即失效，
# 但排障/写断言要用 —— 维护在本地，AGENTS.md 有引用说明。
docs/DEVICE_FACTS.local.md
*.local.md

# TEST_DATA 整体不入库（2026-09-15 起）：实测留痕体积大、含设备序列号与网内 IP，
# 可由设备重建。上面的精细规则保留（对存量已追踪文件仍是 no-op）。
# 若确需留档某份证据，用 git add -f 显式加。
TEST_DATA/

# MCP 单例服务的运行期状态（pid/addr/日志）：机器相关、每次重启即变，不入库。
# 由 mcp_instruments/run_remote.ps1 自动管理（start 幂等、stop 清理）。
mcp_instruments/run/
